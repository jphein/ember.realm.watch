# Copy to `secrets.yaml` (same directory) and fill in.
#
# `secrets.yaml` is gitignored and has never been committed. Keep it that way —
# the API encryption key is a device credential, not a config value.
#
# The two configs between them reference exactly these five keys and no others:
# ember-satellite.yaml uses api_key, wifi_ssid, wifi_password and
# ota_password_satellite; ember-mobile.yaml inherits the first three and
# substitutes ota_password_mobile for the last.

# ESPHome native-API encryption key: 32 random bytes, base64-encoded.
#
#   python3 -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
#
# This must match the key Home Assistant has stored for the device. If you
# regenerate it you have to re-add the device in HA (Settings -> Devices &
# Services -> ESPHome), because HA will no longer be able to decrypt the
# connection and the device just shows as unavailable with no useful error.
api_key: "REPLACE_ME_32_RANDOM_BYTES_BASE64"

# The WiFi network the satellite joins. A 2.4GHz SSID — the ESP32-S3 has no
# 5GHz radio, and a band-steering SSID that only advertises 5GHz will look
# like a wrong password.
wifi_ssid: "your-ssid"
wifi_password: "your-wifi-password"

# OTA credentials, ONE PER BOARD, and they must DIFFER from each other.
#
#   python3 -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(32)))"
#
# Unlike api_key these are not shared with Home Assistant — HA authenticates over
# the native API, not OTA — so regenerating one costs a USB flash of that board
# and nothing else. No re-adoption, no lost entities.
#
# WHY TWO, when one would already stop an outsider: the realistic accident with
# two boards from the same batch on one network is pushing one board's firmware
# at the other. That succeeds with a shared password, and the victim reboots
# renamed — answering to the wrong hostname with its Home Assistant entities
# orphaned. Distinct passwords make it fail at authentication instead.
#
# ⚠️ First flash of a NEW board is over USB and needs neither of these. The
# transition is also safe in that direction: a board whose current firmware has
# no OTA password accepts the OTA that installs one.
ota_password_satellite: "REPLACE_ME_32_RANDOM_CHARS"
ota_password_mobile: "REPLACE_ME_A_DIFFERENT_32_RANDOM_CHARS"
