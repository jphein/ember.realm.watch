# --- secrets -----------------------------------------------------------------
# esphome/secrets.yaml holds the API encryption key and WiFi credentials.
# It has never been committed and must stay that way. See secrets.yaml.example.
secrets.yaml

# --- ESPHome build artifacts -------------------------------------------------
.esphome/
*.bin
*.elf
*.map

# --- Python ------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo

# --- editor / OS -------------------------------------------------------------
*.swp
*~
.DS_Store

# CAD toolchain venv — ~700MB of OpenCASCADE wheels, recreated in one command from
# enclosure/tools/requirements.txt, which pins the exact set the shipped STLs were built
# with. Note the name is cadenv, not venv: a generic venv rule does NOT match it.
enclosure/cadenv/

# frozen print sets — kept deliberately, see the print-* tags
print-ready/

# Gated exports: a build writes here and only renames to .stl once every check passes.
# A leftover .partial means a build FAILED — it is a diagnostic, not an artifact.
*.stl.partial

# Harness render dumps (dragon_harness dumps wyrm_<state>.ppm into the cwd) — generated, look-then-delete
wyrm_*.ppm
